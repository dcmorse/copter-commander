;;; -*- Mode: lisp; -*-

(define-coco-level wind-walker
    1 7                                 ; coco-version
    2                                   ; level-version
    8000                                ; width
    ((ggpb (pillbox (- board-w (w pillbox)) good-guys 0 gghq))
     (gghq (headquarters (right-center headquarters 300) good-guys ggpb))
     (gglp (landing-pad (right-center headquarters 500)))
        
     (bbpb (pillbox 0 bad-guys 0 bbhq))      
     (bbhq (headquarters (left-center headquarters 300) bad-guys bbpb))
     (bblp (landing-pad (left-center landing-pad 500)))

     (nil  (traffic-sign (left-center traffic-sign -300) 0))
     (nil  (traffic-sign (right-center traffic-sign -300) 0))

     ;; center cluster
     (midpad (landing-pad (/ board-w 2)))
     (nil (hut (- (/ (- board-w (w hut)) 2) 150) bad-guys))
     (nil (hut (- (/ (- board-w (w hut)) 2) 225) bad-guys))
     (nil (hut (+ (/ (- board-w (w hut)) 2) 150) good-guys))
     (nil (hut (+ (/ (- board-w (w hut)) 2) 225) good-guys))
     (nil (at-gun (- (/ (- board-w (w at-gun)) 2) 350) bad-guys))
     (nil (aa-gun (- (/ (- board-w (w aa-gun)) 2) 400) bad-guys))
     (nil (at-gun (+ (/ (- board-w (w at-gun)) 2) 350) good-guys))
     (nil (aa-gun (+ (/ (- board-w (w aa-gun)) 2) 400) good-guys))

     ;; left cluster
     (nil (aa-gun (left-center aa-gun 1900) bad-guys))
     (nil (at-gun (left-center at-gun 1850) bad-guys))
     ;(nil (aa-gun (left-center aa-gun 1800) bad-guys))
     (nil (bunker (left-center bunker 2000) bad-guys 2))
     (nil (aa-gun (left-center aa-gun 2100) bad-guys))
     (nil (at-gun (left-center at-gun 2150) bad-guys))
     ;(nil (aa-gun (left-center aa-gun 2200) bad-guys))

     ;; right cluster
     (nil (aa-gun (right-center aa-gun 1900) bad-guys))
     (nil (at-gun (right-center at-gun 1850) bad-guys))
     ;(nil (aa-gun (right-center aa-gun 1800) bad-guys))
     (nil (bunker (right-center bunker 2000) bad-guys 2))
     (nil (aa-gun (right-center aa-gun 2100) bad-guys))
     (nil (at-gun (right-center at-gun 2150) bad-guys))
     ;(nil (aa-gun (right-center aa-gun 2200) bad-guys))

     ;; clouds
     (nil (cloud (+ 0000 (random 1000)) (+ balloon-y-min (random (- board-h balloon-y-min 150)))))
     (nil (cloud (+ 1000 (random 1000)) (+ balloon-y-min (random (- board-h balloon-y-min 150)))))
     (nil (cloud (+ 2000 (random 1000)) (+ balloon-y-min (random (- board-h balloon-y-min 150)))))
     (nil (cloud (+ 3000 (random 1000)) (+ balloon-y-min (random (- board-h balloon-y-min 150)))))
     (nil (cloud (+ 4000 (random 1000)) (+ balloon-y-min (random (- board-h balloon-y-min 150)))))
     (nil (cloud (+ 5000 (random 1000)) (+ balloon-y-min (random (- board-h balloon-y-min 150)))))
     (nil (cloud (+ 6000 (random 1000)) (+ balloon-y-min (random (- board-h balloon-y-min 150)))))
     (nil (cloud (+ 7000 (random 1000)) (+ balloon-y-min (random (- board-h balloon-y-min 150)))))

     ))
