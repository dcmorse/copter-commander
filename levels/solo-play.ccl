(define-coco-level solo-play
    1 0                                 ; coco-version
    1                                   ; level-version
    8000                                ; width
    ((ggpb (pillbox (- board-w (w pillbox)) good-guys 0 gghq))
     (gghq (headquarters (right-center headquarters 500) good-guys ggpb))
     (gglp (landing-pad (right-center headquarters 300)))
     
     (bbpb (pillbox 0 bad-guys 0 bbhq))      
     (bbhq (headquarters (left-center headquarters 500) bad-guys bbpb))
     (bblp (landing-pad (left-center landing-pad 300)))

     (nil  (traffic-sign (left-center traffic-sign -300) 0))
     (nil  (traffic-sign (right-center traffic-sign -300) 0))

     ;; center cluster
     (midpad (landing-pad (/ (- board-w landing-pad) 2)))
     (nil (hut (left-center hut 3800) bad-guys))
     (nil (hut (left-center hut 3900) bad-guys))
     (nil (aa-gun (left-center gun 3700) bad-guys))
     (nil (at-gun (left-center gun 3650) bad-guys))
     (nil (aa-gun (left-center gun 3600) bad-guys))
     (nil (hut (right-center hut 3800) bad-guys))
