(define-coco-level balloon-run
    1 7                                 ; coco-version
    2                                   ; level-version
    5000                               ; width
    ((ggpb (pillbox (- board-w (w pillbox)) good-guys 0 gghq))
     (gghq (headquarters (right-center headquarters 300) good-guys ggpb))
     (gglp (landing-pad (right-center headquarters 500)))
        
     (bbpb (pillbox 0 bad-guys 0 bbhq))      
     (bbhq (headquarters (left-center headquarters 300) bad-guys bbpb))
     (bblp (landing-pad (left-center landing-pad 500)))

     (nil  (traffic-sign (left-center traffic-sign -300) 0))
     (nil  (traffic-sign (right-center traffic-sign -300) 0))

     (nil (balloon-factory (/ (- board-w (w balloon-factory)) 2) 20))
     (nil (balloon-factory (+ (/ (- board-w (w balloon-factory)) 2) 400) 20))
     (nil (balloon-factory (- (/ (- board-w (w balloon-factory)) 2) 400) 20))

