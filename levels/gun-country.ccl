;;; -*- Mode: lisp; -*-

(define-coco-level gun-country
    1 0                                 ; coco-version
    1                                   ; level-version
    4000                                ; width
    ((ggpb (pillbox (- board-w (w pillbox)) good-guys 0 gghq))
     (gghq (headquarters (right-center headquarters 500) good-guys ggpb))
     (gglp (landing-pad (right-center headquarters 300)))
        
     (bbpb (pillbox 0 bad-guys 0 bbhq))      
     (bbhq (headquarters (left-center headquarters 500) bad-guys bbpb))
     (bblp (landing-pad (left-center landing-pad 300)))

     (nil  (traffic-sign (left-center traffic-sign -300) 0))
     (nil  (traffic-sign (right-center traffic-sign -300) 0))

     ;; center cluster
     (nil (bunker (/ (- board-w (w bunker)) 2) bad-guys 0))
     (nil (at-gun (+ (/ (- board-w (w at-gun)) 2) 120) good-guys))
     (nil (at-gun (- (/ (- board-w (w at-gun)) 2) 120) bad-guys))


     ;; left side guns
     (nil (aa-gun (left-center aa-gun 1700) bad-guys))
     (nil (aa-gun (left-center aa-gun 1600) good-guys))
     (nil (aa-gun (left-center aa-gun 1500) bad-guys))
     (nil (aa-gun (left-center aa-gun 1400) good-guys))
     (nil (aa-gun (left-center aa-gun 1300) bad-guys))
     (nil (aa-gun (left-center aa-gun 1200) good-guys))
     (nil (aa-gun (left-center aa-gun 1100) bad-guys))
     (nil (aa-gun (left-center aa-gun 1000) good-guys))
     (nil (aa-gun (left-center aa-gun 900) bad-guys))

     ;; right side guns
     (nil (aa-gun (right-center aa-gun 1700) good-guys))
     (nil (aa-gun (right-center aa-gun 1600) bad-guys))
     (nil (aa-gun (right-center aa-gun 1500) good-guys))
     (nil (aa-gun (right-center aa-gun 1400) bad-guys))
     (nil (aa-gun (right-center aa-gun 1300) good-guys))
     (nil (aa-gun (right-center aa-gun 1200) bad-guys))
     (nil (aa-gun (right-center aa-gun 1100) good-guys))
     (nil (aa-gun (right-center aa-gun 1000) bad-guys))
     (nil (aa-gun (right-center aa-gun 900) good-guys))

     ;; clouds
     (nil (cloud (+ 0000 (random 1000)) (+ balloon-y-min (random (- board-h balloon-y-min 150)))))
     (nil (cloud (+ 1000 (random 1000)) (+ balloon-y-min (random (- board-h balloon-y-min 150)))))
     (nil (cloud (+ 2000 (random 1000)) (+ balloon-y-min (random (- board-h balloon-y-min 150)))))
     (nil (cloud (+ 3000 (random 1000)) (+ balloon-y-min (random (- board-h balloon-y-min 150)))))))




